+
+function compactInPlace(items, keep) {
+  if (!Array.isArray(items) || items.length === 0) return;
+  let write = 0;
+  for (let read = 0; read < items.length; read++) {
+    const item = items[read];
+    if (!keep(item)) continue;
+    items[write++] = item;
+  }
+  items.length = write;
+}
