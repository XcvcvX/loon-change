#!name = 哈啰净化（轻量试用版）
#!desc = 独立试用版：保留核心去广告逻辑，延迟初始化 AES、缓存请求判定并减少响应阶段重复解析；不并入 allAdRewrite
#!author = XcvcvX / 基于 ZenmoFeiShi 原始规则改造
#!homepage = https://github.com/XcvcvX/loon-change
#!tag = 去广告,试用
#!system = iOS,iPadOS,macOS

[Rewrite]
^https?:\/\/api-htp\.beizi\.biz\/mb\/sdk0\/json(?:\?|$) url reject-200
^https?:\/\/adservice\.sigmob\.cn\/(?:hb\/v2\/ad|ad\/v4)(?:\?|$) url reject-200
^https?:\/\/tm\.sigmob\.cn\/(?:waterfall\/v1|strategy\/v6)(?:\?|$) url reject-200
^https?:\/\/(?:mi|v2mi)\.gdt\.qq\.com\/(?:gdt_mview\.fcg|server_bidding2)(?:\?|$) url reject-200

[Script]
http-request ^https?:\/\/(?:api|marketingapi|entertainment)\.hellobike\.com(?::\d+)?\/api(?:\?|$) script-path=https://raw.githubusercontent.com/XcvcvX/loon-change/experiment/hellobike-lite/scripts/hellobike-lite.js,tag=HELLOBIKE-REQ,requires-body=true
http-response ^https?:\/\/(?:api|marketingapi|entertainment)\.hellobike\.com(?::\d+)?\/api(?:\?|$) script-path=https://raw.githubusercontent.com/XcvcvX/loon-change/experiment/hellobike-lite/scripts/hellobike-lite.js,tag=HELLOBIKE-RESP,requires-body=true
http-response ^https:\/\/api\.hellobike\.com(?::443)?\/secretkey(?:\?|$) script-path=https://raw.githubusercontent.com/XcvcvX/loon-change/experiment/hellobike-lite/scripts/hellobike-lite.js,tag=HELLOBIKE-KEY,requires-body=true
http-response ^https:\/\/taxiapi\.hellobike\.com(?::443)?\/api(?:\?|$) script-path=https://raw.githubusercontent.com/XcvcvX/loon-change/experiment/hellobike-lite/scripts/hellobike-lite.js,tag=HELLOBIKE-TAXI,requires-body=true
http-response ^https:\/\/resource\.51downapp\.cn\/f414fbc17c411b4e986ba8891c738a49\.json(?:\?|$) script-path=https://raw.githubusercontent.com/XcvcvX/loon-change/experiment/hellobike-lite/scripts/hellobike-lite.js,tag=HELLOBIKE-RESOURCE,requires-body=true

[MITM]
hostname = api.hellobike.com, taxiapi.hellobike.com, marketingapi.hellobike.com, entertainment.hellobike.com, resource.51downapp.cn
