#!name = 哈啰净化（轻量试用版 V2）
#!desc = V2：仅在目标 API 响应阶段触发，按 URL 动作路由收窄匹配；恢复完整广告 action 处理，延迟初始化 AES。独立试用，不并入 allAdRewrite
#!author = XcvcvX / 基于 ZenmoFeiShi 原始规则改造
#!homepage = https://github.com/XcvcvX/loon-change
#!tag = 去广告,试用
#!system = iOS,iPadOS,macOS

[Rewrite]
^https?:\/\/api-htp\.beizi\.biz\/mb\/sdk0\/json(?:\?|$) url reject-200
^https?:\/\/adservice\.sigmob\.cn\/(?:hb\/v2\/ad|ad\/v4)(?:\?|$) url reject-200
^https?:\/\/tm\.sigmob\.cn\/(?:waterfall\/v1|strategy\/v6)(?:\?|$) url reject-200
^https?:\/\/(?:mi|v2mi)\.gdt\.qq\.com\/(?:gdt_mview\.fcg|server_bidding2)(?:\?|$) url reject-200

[Script]
http-response ^https?:\/\/(?:api|marketingapi|entertainment)\.hellobike\.com(?::\d+)?\/api\?(?:[^#]*&)?(?:adx(?:\.ssp\.show)?|homepage\.startup\.popupWindow|homepage\.feeds\.data|homepage\.feeds\.second\.data|homepage\.waterfall\.module\.data|homepage\.module\.newdata|homepage\.shortcut\.scene\.perception|lego\.bff\.data)(?:&|$) script-path=https://raw.githubusercontent.com/XcvcvX/loon-change/experiment/hellobike-lite/scripts/hellobike-lite.js,tag=HELLOBIKE-RESP-V2,requires-body=true
http-response ^https:\/\/api\.hellobike\.com(?::443)?\/secretkey(?:\?|$) script-path=https://raw.githubusercontent.com/XcvcvX/loon-change/experiment/hellobike-lite/scripts/hellobike-lite.js,tag=HELLOBIKE-KEY-V2,requires-body=true
http-response ^https:\/\/taxiapi\.hellobike\.com(?::443)?\/api\?(?:[^#]*&)?hitch\.driver\.journeyList(?:&|$) script-path=https://raw.githubusercontent.com/XcvcvX/loon-change/experiment/hellobike-lite/scripts/hellobike-lite.js,tag=HELLOBIKE-TAXI-V2,requires-body=true
http-response ^https:\/\/resource\.51downapp\.cn\/f414fbc17c411b4e986ba8891c738a49\.json\?(?:[^#]*&)?md5=e5230c919f7e3f3af3256161fbfaa0e2&(?:[^#]*&)?hbe_qx_ui=1\.3$ script-path=https://raw.githubusercontent.com/XcvcvX/loon-change/experiment/hellobike-lite/scripts/hellobike-lite.js,tag=HELLOBIKE-RESOURCE-V2,requires-body=true

[MITM]
hostname = api.hellobike.com, taxiapi.hellobike.com, marketingapi.hellobike.com, entertainment.hellobike.com, resource.51downapp.cn
